import System.Collections.*
List<String> recurheap=new List<String>(); int recurrence=1
void recurse(){ auto recursed=new Thread( function main(){ Thread.sleep(0); recurring() } ); recursed() }
void recurring(){ println("recursion is notgodlynoah's passion #${recurrence}"); recurrence=recurrence+1; String recurrent="RecurringRecursiveRecursionsRecurRecurrences".repeat(recurrence)+" #${recurrence}"; recurheap.add(recurrent); auto recursive=new Thread( function main(String recurred){ while(true){ println("Running ${recurred}"); recurse(); Thread.sleep(0) } } ); recursive(recurrent) }
void main(){ recurse(); while(true){ Thread.sleep(1000) } }
